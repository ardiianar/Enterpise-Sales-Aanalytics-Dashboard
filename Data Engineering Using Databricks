   "source": [
    "from pyspark.sql.functions import col\n",
    "\n",
    "df_bronze = spark.table(\"workspace.default.bronze_ecommerce\")\n",
    "\n",
    "df_silver = df_bronze.dropDuplicates()\n",
    "\n",
    "df_silver = df_silver.fillna({\n",
