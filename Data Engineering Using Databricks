    "dt = DecisionTreeClassifier(\n",
    "    featuresCol=\"features\",\n",
    "    labelCol=\"label\",\n",
    "    predictionCol=\"prediction\",\n",
    "    maxDepth=5\n",
    ")\n",
    "\n",
    "pipeline = Pipeline(\n",
    "    stages=[\n",
    "        classification_assembler,\n",
    "        label_indexer,\n",
    "        dt\n",
    "    ]\n",
    ")\n",
    "\n",
    "train_cls, test_cls = df_classification.randomSplit([0.8, 0.2], seed=42)\n",
