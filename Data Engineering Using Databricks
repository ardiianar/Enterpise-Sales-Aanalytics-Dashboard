   "source": [
    "import re\n",
    "\n",
    "def clean_column(col):\n",
    "    col = col.strip()  # hapus spasi depan belakang\n",
    "    col = col.lower()  # jadi huruf kecil\n",
    "    col = re.sub(r'[ ,;{}()\\n\\t=]+', '_', col)  # ganti karakter aneh jadi _\n",
    "    return col\n",
    "\n",
    "df = df.toDF(*[clean_column(c) for c in df.columns])"
   ]
